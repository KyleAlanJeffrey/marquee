{
  "name": "marquee",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@clerk/backend": "3.14.0",
    "@clerk/expo": "^4.1.2",
    "@expo-google-fonts/anybody": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@hono/zod-validator": "^0.9.0",
    "@kylealanjeffrey/badge": "^0.0.2",
    "@tanstack/react-query": "^5.101.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~56.0.11",
    "expo-auth-session": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-font": "~56.0.6",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-location": "~56.0.17",
    "expo-notifications": "~56.0.17",
    "expo-router": "~56.2.10",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "hono": "^4.6.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^3.114.0"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export -p web",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "db:apply:local": "wrangler d1 execute marquee --local --file=worker/schema.sql && npm run db:migrate && wrangler d1 execute marquee --local --file=worker/seed.sql",
    "db:apply": "wrangler d1 execute marquee --remote --file=worker/schema.sql && npm run db:migrate:remote",
    "db:migrate": "wrangler d1 migrations apply marquee --local",
    "db:migrate:remote": "wrangler d1 migrations apply marquee --remote",
    "lint": "expo lint",
    "test": "vitest run",
    "db:unseed": "wrangler d1 execute marquee --local --file=worker/unseed.sql",
    "db:unseed:remote": "wrangler d1 execute marquee --remote --file=worker/unseed.sql"
  },
  "private": true
}
