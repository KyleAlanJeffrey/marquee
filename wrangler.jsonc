// Cloudflare config for the website Worker: the web app (static assets), the
// API, and the /img mirror. The cron crawl, IndexNow and the admin endpoints
// live on the jobs Worker — see wrangler.jobs.jsonc.
// database_id points at the existing "marquee" D1 (wrangler v3 requires it).
// After the first deploy:
//   1. load worker/schema.sql (D1 -> marquee -> Console, or `npm run db:apply`)
//   2. set secrets on the Worker (Worker -> Settings -> Variables and Secrets):
//      TICKETMASTER_API_KEY, SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET,
//      BANDSINTOWN_APP_ID, SEATGEEK_CLIENT_ID, CLERK_SECRET_KEY, INDEXNOW_KEY.
//      ADMIN_TOKEN belongs to the jobs Worker only. EXPO_PUBLIC_* are
//      build *variables*, not secrets — they are inlined into the web bundle.
// Deploys automatically via Cloudflare Workers Builds (Git integration):
//   build command: npm run build   (expo export -> ./dist)
//   deploy command: npx wrangler deploy
{
  "name": "marquee",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-11-27",
  // The production domain is marquee.rocks, attached as a Custom Domain in the
  // dashboard. Declaring it here instead is equivalent and more reproducible —
  // but `wrangler deploy` errors if the zone isn't active, and deploys run on
  // every push, so an inactive zone would break the pipeline and not just the
  // domain. Uncomment once `dig NS marquee.rocks` answers with Cloudflare's
  // nameservers and the zone reads Active.
  // "routes": [{ "pattern": "marquee.rocks", "custom_domain": true }],
  // Exposes the deployment id to the Worker. The page cache keys on it, so a
  // deploy invalidates the rendered HTML instead of serving the previous copy
  // until s-maxage runs out.
  "version_metadata": { "binding": "CF_VERSION" },

  "assets": {
    // The Expo web export. The Worker runs first for every request and either
    // handles /api/* or hands off to ASSETS (SPA fallback for client routes).
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  // The hostname the site is indexed under. Canonicals, og:url and the sitemap
  // are all built from this rather than from whichever host served the request,
  // so the *.workers.dev name can't compete with marquee.rocks in the index.
  "vars": {
    "PRIMARY_HOST": "marquee.rocks",
  },
  // The image mirror. `/img/…` serves artist images from here (cache-aside:
  // mirrored from the source CDN on first request) instead of hotlinking
  // Spotify/Ticketmaster/SeatGeek URLs that rot and rate-limit.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "marquee",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marquee",
      "database_id": "3905e807-3b98-465c-874d-ba558bf319da",
      // worker/schema.sql is the baseline; every change after it is a numbered
      // migration (`npm run db:migrate` / `db:migrate:remote`).
      "migrations_dir": "worker/migrations",
    },
  ],
  // No cron here: the 15-minute artist crawl runs on the jobs Worker
  // (wrangler.jobs.jsonc), so ingestion can't spend this Worker's budgets.
  // The empty array is load-bearing — omitting `triggers` entirely leaves any
  // previously deployed schedule in place, still firing at a Worker that no
  // longer exports a scheduled handler.
  "triggers": {
    "crons": [],
  },
  "observability": {
    "enabled": true,
  },
}
