# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Supabase CLI local state
supabase/.branches
supabase/.temp
# local env files
.env
.env.*
!.env.example
# Tracked deliberately: EXPO_PUBLIC_* values are inlined into the public bundle
# anyway, and a build variable that only exists in the Cloudflare dashboard is a
# build that breaks on a fresh clone with nothing saying why.
!.env.production

# Cloudflare Worker
.wrangler/
.dev.vars
