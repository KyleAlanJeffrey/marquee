# Copy to .env and set the Marquee Worker API URL.
# Local dev:  http://localhost:8787  (from `wrangler dev` in ./worker)
# Production: https://marquee.rocks
# Only the *native* build needs this. The web build is served by the same Worker
# that answers /api, so it uses same-origin relative URLs and ignores this.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Optional: a Mapbox *public* token (pk.*) turns the "Nearby Venues" card into a
# real dark map (Mapbox Static Images API). Without it, a stylized grid is shown.
# Publishable client-side; set it here for local dev and as a build-time env var
# in Cloudflare Workers Builds for production.
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.xxxxx

# Accounts (Clerk). Unset is a supported way to run this app: the provider is not
# mounted at all, every request is anonymous, and everything except publishing —
# browsing, following, saving, reminders, the private log — works exactly as it
# did before accounts existed.
# Publishable by design (it identifies the Clerk instance, it does not authorise
# anything); the secret half lives in the Worker's .dev.vars.
#
# Setting this WITHOUT the Worker's CLERK_SECRET_KEY is the one combination to
# avoid: the app can sign somebody in while the API still verifies nothing, so it
# looks signed-in and every write 401s. Set both or neither.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
